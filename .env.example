# Supabase public client configuration. The local URL is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy Supabase projects may provide an anon key instead of a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional and server-side only. Leave unset until a privileged operation is actually required.
# Never expose this key to the browser or commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MailerSend server-side configuration. Use a safe/test sender during development.
MAILERSEND_API_KEY=your-mailersend-api-key
MAILERSEND_FROM_EMAIL=sender@example.com
MAILERSEND_FROM_NAME=The Solas Guide
SOLAS_OPERATIONS_EMAIL=operations@example.com
CRON_SECRET=replace-with-a-long-random-secret

# One-way Airtable CRM projection. These remain server-only. The webhook hash
# is SHA-256(secret); the raw secret belongs only in Supabase Vault.
AIRTABLE_API_KEY=your-airtable-pat
AIRTABLE_BASE_ID=appMRnCvpFjFUlOyw
AIRTABLE_SYNC_WEBHOOK_SECRET_HASH=sha256-of-supabase-vault-webhook-secret
AIRTABLE_SYNC_REPLAY_SECRET=replace-with-a-long-random-secret

# Base URL used when the application creates links back to itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional future analytics configuration; leave unset until the GA4 property is available.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
